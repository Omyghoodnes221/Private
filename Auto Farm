        return text(card, value, 12, 29, width - 24, 23, 19, accent or C.text, Enum.Font.GothamBold)
    end

    UI.Time = metric(16, 146, "TIME", "00:00:00")
    UI.CashRate = metric(170, 224, "PROFIT / HOUR", "$0 / hr", C.orange)

    local dot = make("Frame", {
        Position = UDim2.fromOffset(17, 88), Size = UDim2.fromOffset(5, 5),
        BackgroundColor3 = C.orange, BorderSizePixel = 0,
    }, body)
    round(dot, 3)
    text(body, "STATE", 30, 82, 42, 16, 9, C.muted)
