--// Cash + shop lookups
local function GetCash()
    local Found = {}
    local dropParent = workspace:FindFirstChild('Ignored') and workspace.Ignored:FindFirstChild('Drop')
    if not dropParent then return Found end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
    if not hrp then return Found end

    for _, v in ipairs(dropParent:GetChildren()) do
        if v.Name == 'MoneyDrop' and not pickedUpCash[v] and v:IsA("BasePart") then
            if (v.Position - hrp.Position).Magnitude <= (getgenv().CASH_AURA_RANGE + 20) then
                table.insert(Found, v)
            end
        end
    end
    return Found
end

local shopFolder = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")

local function findShopItem(nameKeyword)
    if not shopFolder then return nil end
    for _, item in ipairs(shopFolder:GetChildren()) do
        if string.find(item.Name, nameKeyword) then
            return item
        end
    end
    return nil
end

local function getPartCFrame(instance)
    if instance:IsA("BasePart") then return instance.CFrame end
    if instance:IsA("Model") then
        if instance.PrimaryPart then return instance.PrimaryPart.CFrame end
        local bp = instance:FindFirstChildWhichIsA("BasePart")
        if bp then return bp.CFrame end
    end
    return nil
end

local function serverHop()
    if isHopping or not getgenv().On then return end
    isHopping = true

    local success, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)

    if success then
        local data = HttpService:JSONDecode(response)
        local possibleServers = {}
        local minPlayers = getgenv().MIN_PLAYERS or 5
        local maxPlayers = getgenv().TARGET_MAX_PLAYERS or 35

        for _, server in ipairs(data.data) do
            if type(server) == "table" and server.playing and server.maxPlayers then
                if server.playing >= minPlayers and server.playing <= maxPlayers and server.id ~= game.JobId then
                    table.insert(possibleServers, server.id)
                end
            end
        end

        if #possibleServers > 0 then
            local target = possibleServers[math.random(1, #possibleServers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target, LocalPlayer)
            task.wait(5)
            return
        end
    end

    task.wait(1)
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
end

--// Shop purchases
local function BuyGunGears()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hasGun = LocalPlayer.Backpack:FindFirstChild("[Drum-Shotgun]")
        or char:FindFirstChild("[Drum-Shotgun]")

    if not hasGun then
        UpdateUIState("Buying Gun")
        if getCurrentMoney() >= 1238 then
            local gunItem = findShopItem("%[Drum%-Shotgun%]")
            if gunItem then
                local cd = gunItem:FindFirstChildOfClass("ClickDetector")
                local targetCF = getPartCFrame(gunItem)
                if cd and targetCF then
                    hrp.CFrame = targetCF * CFrame.new(0, 2, 0)
                    task.wait(0.3)
                    if _fireclickdetector then _fireclickdetector(cd, 0) end
                    task.wait(0.5)
                end
            end
        end
    end

    if (getgenv().ammoBoughtCount < 4 or getAmmoCount() == 0) and getCurrentMoney() >= 73 then
        UpdateUIState("Buying Ammo")
        local ammoItem = findShopItem("18 %[Drum%-Shotgun Ammo%]")
        if ammoItem then
            local cd = ammoItem:FindFirstChildOfClass("ClickDetector")
            local targetCF = getPartCFrame(ammoItem)
            if cd and targetCF then
                if getAmmoCount() == 0 then getgenv().ammoBoughtCount = 0 end
                while (getgenv().ammoBoughtCount < 4 or getAmmoCount() == 0) and getCurrentMoney() >= 73 do
                    if isCuffed or not getgenv().On then break end
                    hrp.CFrame = targetCF * CFrame.new(0, 2, 0)
                    task.wait(0.3)
                    if _fireclickdetector then _fireclickdetector(cd, 0) end
                    getgenv().ammoBoughtCount = getgenv().ammoBoughtCount + 1
                    task.wait(0.4)
                end
            end
        end
    end
end

--// Key handling
local keyUsed = false
local keyActive = false

local function findKeyTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    for _, container in ipairs({char, backpack}) do
        if container then
            for _, v in ipairs(container:GetChildren()) do
                if v:IsA("Tool") and string.find(v.Name:lower(), "key", 1, true) then
                    return v
                end
            end
        end
    end
end

local function equipAndUseKey()
    if keyUsed then return end
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not char or not humanoid or not backpack then return end

    local tool = findKeyTool()
    if not tool then return end

    keyUsed = true
    if tool.Parent == backpack then
        humanoid:EquipTool(tool)
        task.wait(0.1)
    end
    if tool.Parent == char then
        pcall(function() tool:Activate() end)
    end
    keyActive = false
end

local function buyKey()
    if not keyActive or keyUsed then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local shopItem = findShopItem("%[Key%]")
    if not shopItem then return end
    local part = getPartCFrame(shopItem)
    if not part then return end

    hrp.CFrame = part * CFrame.new(0, 2, 0)
    local cd = shopItem:FindFirstChildOfClass("ClickDetector")
    if cd and _fireclickdetector then
        pcall(function() _fireclickdetector(cd, 0) end)
    end
end

local function monitorCuff(char)
    keyActive = false
    keyUsed = false

    local bodyEffects = char:WaitForChild("BodyEffects", 5)
    if not bodyEffects then return end
    local cuff = bodyEffects:WaitForChild("Cuff", 5)
    if not cuff then return end

    cuff.Changed:Connect(function(val)
        isCuffed = val
        if isCuffed then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            getgenv().selectedCashier = nil
            getgenv().isLooting = false
            getgenv().noclipCashier = false
        end
    end)

    task.spawn(function()
        while cuff.Parent do
            if not getgenv().On then
                task.wait(0.5)
                continue
            end
            if cuff.Value == true then
                if not keyActive and not keyUsed then keyActive = true end
                if findKeyTool() then
                    equipAndUseKey()
                else
                    buyKey()
                end
            else
                keyActive = false
                keyUsed = false
            end
            task.wait(0.05)
        end
        keyActive = false
    end)
end

if LocalPlayer.Character then task.spawn(monitorCuff, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    task.spawn(monitorCuff, char)
end)

--// Loot sequence
local function executeLootSequence(hum, hrp, currentLootTarget)
    UpdateUIState("Picking up cash")
    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    hum:UnequipTools()
    task.wait(0.3)

    local pickupStart = tick()
    while (tick() - pickupStart) < 20 do
        if not getgenv().On or isCuffed or not getgenv().isLooting
            or (currentLootTarget and getgenv().selectedCashier ~= currentLootTarget) then break end

        local CashItems = GetCash()
        if #CashItems == 0 then break end

        for _, v in ipairs(CashItems) do
            if not getgenv().On or isCuffed or not getgenv().isLooting
                or (currentLootTarget and getgenv().selectedCashier ~= currentLootTarget) then break end
            if v and v.Parent and not pickedUpCash[v] then
                local cd = v:FindFirstChildOfClass('ClickDetector')
                if cd and hrp then
                    pickedUpCash[v] = true
                    while v and v.Parent and _fireclickdetector and not isCuffed and getgenv().On do
                        hrp.CFrame = CFrame.new(v.Position - Vector3.new(0, 3, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero

                        local offset = Vector3.new(math.random(-5, 5), math.random(3, 6), math.random(-5, 5))
                        workspace.CurrentCamera.CFrame = CFrame.lookAt(v.Position + offset, v.Position)

                        _fireclickdetector(cd, 0)
                        task.wait(0.05)
                        if not v or not v.Parent then break end
                    end
                    task.wait(PICKUP_DELAY)
                end
            end
        end
        RunService.RenderStepped:Wait()
    end
    task.wait(0.3)
end

