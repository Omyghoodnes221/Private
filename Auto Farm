                if hum then
                    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    if hum.Sit then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end

                if not (char and char:FindFirstChild("FULLY_LOADED_CHAR") and hum and hrp) then return end

                if char:FindFirstChild("Christmas_Sock") then
                    UpdateUIState("Resetting Character...")
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                    getgenv().selectedCashier = nil
                    getgenv().isLooting = false
                    hum.Health = 0
                    task.wait(1)
                    return
                end

                local isKO = char:FindFirstChild("BodyEffects")
                    and char.BodyEffects:FindFirstChild("K.O")
                    and char.BodyEffects["K.O"].Value == true
                if hum.Health <= 15 or isKO then
                    UpdateUIState("Dead")
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                    getgenv().selectedCashier = nil
                    getgenv().isLooting = false
                    for _, partName in ipairs({
                        'Head','RightHand','LeftHand','LowerTorso','UpperTorso',
                        'LeftLowerLeg','RightLowerLeg','RightFoot','LeftFoot',
                        'LeftUpperLeg','RightUpperLeg','RightUpperArm','RightLowerArm',
                        'LeftLowerArm','LeftUpperArm',
                    }) do
                        local part = char:FindFirstChild(partName)
                        if part then part:Destroy() end
                    end
                    task.wait(1)
                    return
                end

                local currentMoney = getCurrentMoney()
                local canAffordGunfarm = currentMoney >= 20000
                local hasGun = LocalPlayer.Backpack:FindFirstChild("[Drum-Shotgun]")
                    or char:FindFirstChild("[Drum-Shotgun]")
                local outOfAmmo = hasGun and getAmmoCount() <= 0

                if getgenv().Gunfarm and canAffordGunfarm then
                    if not hasGun or getgenv().ammoBoughtCount < 4 or outOfAmmo then
                        getgenv().selectedCashier = nil
                        getgenv().isLooting = false
                        getgenv().noclipCashier = false
                        LocalPlayer.CameraMode = Enum.CameraMode.Classic
                        BuyGunGears()
                        return
                    end
                elseif currentMoney < 20000 then
                    getgenv().ammoBoughtCount = 0
                end

                local cashier = getgenv().selectedCashier

                if cashier and (cashier:FindFirstChild("Head") or getgenv().isLooting) then
                    if getgenv().isLooting
                        or (cashier:FindFirstChild("Humanoid") and cashier.Humanoid.Health < 1) then
                        if not getgenv().isProcessingCash then
                            getgenv().isProcessingCash = true
                            getgenv().isLooting = true
                            local currentLootTarget = cashier
                            executeLootSequence(hum, hrp, currentLootTarget)
                            if getgenv().selectedCashier == currentLootTarget then
                                getgenv().selectedCashier = nil
                                getgenv().noclipCashier = false
                            end
                            getgenv().isProcessingCash = false
                            getgenv().isLooting = false
                            task.wait(0.4)
                        end
                    elseif cashier:FindFirstChild("Humanoid") and cashier.Humanoid.Health >= 1 then
                        if cashier:FindFirstChild("Open") then
                            local cashierCF = cashier.Open.CFrame
                            local targetPos
                            if getgenv().Gunfarm and canAffordGunfarm and not outOfAmmo then
                                UpdateUIState("Attacking with Gun...")
                                targetPos = (cashierCF * CFrame.new(0, 0.5, 3.4)).Position
                                hrp.CFrame = CFrame.lookAt(targetPos, cashierCF.Position)
                            else
                                UpdateUIState("Attacking with Combat...")
                                targetPos = (cashierCF * CFrame.new(0, 5.5, 0)).Position
                                hrp.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end

                        if not getgenv().noclipCashier then
                            getgenv().noclipCashier = true
                            for _, v in pairs(cashier:GetDescendants()) do
                                if v:IsA("BasePart") then v.CanCollide = false end
                            end
                        end

                        if getgenv().Gunfarm and canAffordGunfarm and not outOfAmmo then
                            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
                            if cashier:FindFirstChild("Head") then
                                local targetPosition = cashier.Head.Position - Vector3.new(0, 1.6, 0)
                                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPosition)
                            end
                        else
                            LocalPlayer.CameraMode = Enum.CameraMode.Classic
                        end

                        local weaponName = (getgenv().Gunfarm and canAffordGunfarm and not outOfAmmo)
                            and '[Drum-Shotgun]' or 'Combat'
                        local attackTool = LocalPlayer.Backpack:FindFirstChild(weaponName)
                            or char:FindFirstChild(weaponName)
                        if attackTool then
                            if attackTool.Parent == LocalPlayer.Backpack then
                                attackTool.Parent = char
                            end
                            if attackTool:IsA("Tool") and attackTool.Name ~= "Combat" then
                                local clips = attackTool:FindFirstChild("Clips")
                                    or attackTool:FindFirstChild("Ammo")
                                if clips and clips.Value == 0 then
                                    game:GetService("ReplicatedStorage").MainEvent:FireServer('Reload', attackTool)
                                    task.wait(0.2)
                                end
                            end
                            local bodyEffects = char:FindFirstChild("BodyEffects")
                            if not bodyEffects
                                or (bodyEffects:FindFirstChild("Attacking")
                                    and bodyEffects.Attacking.Value == false) then
                                attackTool:Activate()
                            end
                        end
                    end
                elseif not getgenv().isLooting then
                    UpdateUIState("Scanning atm")
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                    local foundNew = false
                    if workspace:FindFirstChild("Cashiers") then
                        for _, v in pairs(workspace.Cashiers:GetChildren()) do
                            if v.Name:match("CA$HIER") and not v.Name:match("VAULT")
                                and v:FindFirstChild("Humanoid") and v:FindFirstChild("Head") then
                                if v.Humanoid.Health > 25
                                    and (v.Head.Position - Vector3.new(-623.998474, 24.9000168, -285.062225)).Magnitude > 8 then
                                    getgenv().selectedCashier = v
                                    foundNew = true
                                    break
                                end
                            end
                        end
                    end
                    if not foundNew then
                        hrp.CFrame = CFrame.new(9999, 9999, 9999)
                        serverHop()
                    end
                end
            end)
        end
    end
end)

--// Mod detection
local ModTable = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/XK5NG/XK5NG.github.io/refs/heads/main/Contents"))()

do
    local function Check(Player)
        if not Player or Player == LocalPlayer or not Player:IsA("Player") then return end

        local Detect_Type = "Kick"
        local Flags = {}
        local ShouldKick = true

        if ModTable and ModTable[tostring(Player.UserId)] then
            local Message = "a mod has joined your game | triggered by: "
                .. Player.DisplayName .. " (@" .. Player.Name .. ") | id: "
                .. tostring(Player.UserId) .. " | reason: matched"
            if Detect_Type == "Kick" then LocalPlayer:Kick(Message) end
            return
        end

        local ok1, InGroup = pcall(Player.IsInGroup, Player, 10604500)
        if ok1 and InGroup then
            local ok2, Role = pcall(Player.GetRoleInGroup, Player, 10604500)
            if ok2 and Role == "Roblox Verified" then ShouldKick = false end
        end

        for GroupId, Data in pairs({
            [10604500] = {name = "da hood verified", notifies = {"celebs", "roblox verified", "trades"}},
            [17215700] = "stars staff",
            [8068202]  = "da hood stars",
            [4698921]  = {name = "da hood entertainment",
                          forbidden = {"owner", "admin", "devs", "monetization", "contributed", "moderators"}},
        }) do
            local okG, InG = pcall(Player.IsInGroup, Player, GroupId)
            if okG and InG then
                local okR, Role = pcall(Player.GetRoleInGroup, Player, GroupId)
                if okR and Role then
                    if type(Data) == "table" then
                        if Data.forbidden and table.find(Data.forbidden, string.lower(Role)) then
                            table.insert(Flags, Data.name .. "\n" .. Role)
                        end
                    else
                        table.insert(Flags, Data .. "\n" .. Role)
                    end
                end
            end
        end

        if #Flags > 0 and ShouldKick then
            local Reason = table.concat(Flags, ", ")
            local Message = "a mod was on your game | triggered by: "
                .. Player.DisplayName .. " (@" .. Player.Name .. ") | id: "
                .. tostring(Player.UserId) .. " | reason: " .. Reason
            if Detect_Type == "Kick" then LocalPlayer:Kick(Message) end
        end
    end

    for _, Player in pairs(Players:GetPlayers()) do Check(Player) end
    Players.PlayerAdded:Connect(Check)
end
