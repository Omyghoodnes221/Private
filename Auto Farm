    -- Corner cobwebs drawn procedurally
    local function line(parent, x1, y1, x2, y2, transparency)
        local dx, dy = x2 - x1, y2 - y1
        make("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
            Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1),
            Rotation = math.deg(math.atan2(dy, dx)), BorderSizePixel = 0,
            BackgroundColor3 = C.web, BackgroundTransparency = transparency or 0.3,
            ZIndex = 7,
        }, parent)
    end
    local function cobweb(right)
        local originX = right and 416 or -6
        local dir = right and -1 or 1
        local points = {}
        for i = 0, 4 do
            local angle = (math.pi / 2) * i / 4
            local x = originX + dir * math.cos(angle) * 35
            local y = -6 + math.sin(angle) * 35
            points[i + 1] = {x, y}
            line(main, originX, -6, x, y, 0.34)
        end
        for _, radius in ipairs({0.30, 0.58, 0.84}) do
            for i = 1, #points - 1 do
                local a, b = points[i], points[i + 1]
                line(main,
                    originX + (a[1] - originX) * radius, -6 + (a[2] + 6) * radius,
                    originX + (b[1] - originX) * radius, -6 + (b[2] + 6) * radius, 0.38)
            end
        end
    end
    cobweb(false)
    cobweb(true)

